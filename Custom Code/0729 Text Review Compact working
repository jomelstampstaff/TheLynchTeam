    /* Root wrapper - everything inside is isolated */
    #uct-root {
        all: initial; /* Resets all inherited styles */
        display: block;
        max-width: 750px;
        width: 100%;
        margin: 0 auto;
        padding: 6px 4px;
        font-family: 'Poppins', Arial, sans-serif;
        isolation: isolate;
        position: relative;
        box-sizing: border-box;
    }

    /* Reset ALL child elements */
    #uct-root * {
        all: revert;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: 'Poppins', Arial, sans-serif;
    }

    /* Container - fixed height to prevent shift */
    #uct-root .uct-container {
        background: transparent;
        padding: 8px 6px;
        min-height: 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
