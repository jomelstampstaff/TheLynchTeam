        animation: uctSpin 0.8s linear infinite !important;
    }

    @keyframes uctSpin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Fade animation */
    #uct-root .uct-fade {
        animation: uctFade 0.5s ease forwards !important;
    }

    @keyframes uctFade {
        0% {
            opacity: 0;
            transform: translateY(6px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
