</style>

<!-- ============================================================
     HTML STRUCTURE - ULTRA COMPACT
     ============================================================ -->
<div id="uct-root">
    <div class="uct-container" id="uctContainer">
        <!-- Content injected here -->
    </div>
</div>

<!-- ============================================================
     JAVASCRIPT - COMPLETELY ISOLATED
     ============================================================ -->
<script>
    (function() {
        "use strict";

        // ============================================
        // CONFIGURATION
        // ============================================
        const UCT_SHEET_ID = "1geP_5qi9RfTYuwi_e5Oyvchoz0u7TaKGm4NOMqaa90w";
        const UCT_TAB_NAME = "Text Review";
        const UCT_AUTOPLAY_DELAY = 5000;

        // ============================================
        // DOM
        // ============================================
        const container = document.getElementById('uctContainer');
        let reviews = [];
        let currentIndex = 0;
        let autoplayInterval = null;
        let isTransitioning = false;

        // ============================================
        // HELPER FUNCTIONS
        // ============================================
        function shuffleArray(arr) {
            const shuffled = [...arr];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            return shuffled;
        }

        // Render stars using Unicode characters (no Font Awesome needed!)
        function renderStars(rating) {
            const full = Math.floor(rating);
            const half = rating - full >= 0.5 ? 1 : 0;
            const empty = 5 - full - half;
            let html = '';
            
            // Full stars (★)
            for (let i = 0; i < full; i++) {
                html += '<span class="uct-star">★</span>';
            }
            // Half star (use ★ with gradient or just full star for simplicity)
            if (half) {
                html += '<span class="uct-star">★</span>'; // Using full star as fallback
            }
            // Empty stars (☆)
            for (let i = 0; i < empty; i++) {
                html += '<span class="uct-star-empty">☆</span>';
            }
            return html;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }

        function truncateText(text, maxLength) {
            if (!text) return '';
            if (text.length <= maxLength) return text;
            return text.substring(0, maxLength) + '...';
        }

        // ============================================
        // RENDER FUNCTIONS
        // ============================================
        function renderReview(index, animate = true) {
            if (isTransitioning || !reviews.length) return;
            isTransitioning = true;

            const review = reviews[index];
            if (!review) {
                isTransitioning = false;
                return;
            }

            const starsHtml = renderStars(review.star);
            const text = truncateText(review.review, 180);
            const author = escapeHtml(review.author);
            const title = review.title ? escapeHtml(review.title) : null;

            // Build author HTML (inline)
            let authorHtml = `<span class="uct-author-name">${author}</span>`;
            if (title) {
                authorHtml += `<span class="uct-author-divider">•</span>`;
                authorHtml += `<span class="uct-author-title">${title}</span>`;
            }

            // Everything in one line: Stars + Review + Dash + Author
            const html = `
                <div class="uct-review ${animate ? 'uct-fade' : ''}">
                    <span class="uct-stars">${starsHtml}</span>
                    <span class="uct-text">“${text}”</span>
                    <span class="uct-dash">—</span>
                    <span class="uct-author">${authorHtml}</span>
                </div>
            `;

            // Smooth transition
            if (animate) {
                container.style.opacity = '0';
                setTimeout(function() {
                    container.innerHTML = html;
                    container.style.opacity = '1';
                    setTimeout(function() {
                        isTransitioning = false;
                    }, 500);
                }, 150);
            } else {
                container.innerHTML = html;
                setTimeout(function() {
                    isTransitioning = false;
                }, 100);
            }
        }

        // ============================================
        // NAVIGATION
        // ============================================
        function nextReview() {
            if (reviews.length === 0 || isTransitioning) return;
            currentIndex = (currentIndex + 1) % reviews.length;
            renderReview(currentIndex, true);
        }

        // ============================================
        // AUTOPLAY
        // ============================================
        function startAutoplay() {
            if (reviews.length <= 1) return;
            stopAutoplay();
            autoplayInterval = setInterval(nextReview, UCT_AUTOPLAY_DELAY);
        }

        function stopAutoplay() {
            if (autoplayInterval) {
                clearInterval(autoplayInterval);
                autoplayInterval = null;
            }
        }

        // ============================================
        // STATES
        // ============================================
        function showError(msg) {
            container.innerHTML = `
                <div class="uct-error">
                    <span style="margin-right:6px;">⚠️</span>
                    ${msg}
                    <br>
                    <button class="uct-retry" onclick="location.reload()">
                        🔄 Retry
                    </button>
                </div>
            `;
        }

        function showLoading() {
            container.innerHTML = `
                <div class="uct-loading">
                    <div class="uct-spinner"></div>
                    <span>Loading reviews...</span>
                </div>
            `;
        }

        // ============================================
        // FETCH DATA
        // ============================================
        function fetchReviews() {
            showLoading();
            const url = `https://opensheet.elk.sh/${UCT_SHEET_ID}/${UCT_TAB_NAME}`;
            
            fetch(url, { cache: 'no-store' })
                .then(function(r) { 
                    if (!r.ok) throw new Error('HTTP ' + r.status); 
                    return r.json(); 
                })
                .then(function(data) {
                    if (!data || data.length === 0) {
                        showError('No reviews found.');
                        return;
                    }

                    const parsed = data.map(function(row) {
                        const keys = Object.keys(row);
                        return {
                            star: keys.find(function(k) { return /star/i.test(k); }) ? 
                                parseFloat(row[keys.find(function(k) { return /star/i.test(k); })]) || 5 : 5,
                            review: keys.find(function(k) { return /review|desc/i.test(k); }) ? 
                                row[keys.find(function(k) { return /review|desc/i.test(k); })] : 'No review.',
                            author: keys.find(function(k) { return /client|name|author/i.test(k) && !/title/i.test(k); }) ? 
                                row[keys.find(function(k) { return /client|name|author/i.test(k) && !/title/i.test(k); })] : 'Anonymous',
                            title: keys.find(function(k) { return /title/i.test(k) && !/review/i.test(k); }) ? 
                                row[keys.find(function(k) { return /title/i.test(k) && !/review/i.test(k); })] : ''
                        };
                    }).filter(function(r) { return r.review && r.review !== 'No review.'; });

                    if (parsed.length === 0) {
                        showError('No valid reviews.');
                        return;
                    }

                    reviews = shuffleArray(parsed);
                    currentIndex = 0;
                    renderReview(0, false);
                    setTimeout(startAutoplay, 500);
                })
                .catch(function(err) { 
                    console.error('UCT Error:', err);
                    showError('Connection error. Please try again.');
                });
        }

        // ============================================
        // PAUSE ON HOVER
        // ============================================
        container.addEventListener('mouseenter', stopAutoplay);
        container.addEventListener('mouseleave', startAutoplay);

        // ============================================
        // INITIALIZE
        // ============================================
        fetchReviews();

        // Cleanup
        window.addEventListener('beforeunload', function() {
            stopAutoplay();
        });

    })();
</script>
