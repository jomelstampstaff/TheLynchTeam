    #uct-root .uct-author-divider {
        color: #dce1e9 !important;
        font-size: 0.5rem !important;
        padding: 0 2px !important;
        display: inline !important;
    }

    /* Error / Loading states */
    #uct-root .uct-error {
        background: #fef6f6 !important;
        border: 1px solid #fce8e8 !important;
        border-radius: 8px !important;
        padding: 10px 14px !important;
        color: #a33 !important;
        text-align: center !important;
        font-size: 0.85rem !important;
        width: 100% !important;
    }

    #uct-root .uct-retry {
        all: initial !important;
        background: #1d3563 !important;
        color: #ffffff !important;
        border: none !important;
        padding: 5px 18px !important;
        border-radius: 20px !important;
        font-size: 0.75rem !important;
        cursor: pointer !important;
        margin-top: 6px !important;
        font-family: 'Poppins', Arial, sans-serif !important;
        transition: all 0.2s ease !important;
        display: inline-block !important;
    }

    #uct-root .uct-retry:hover {
        background: #2a4a7a !important;
    }

    #uct-root .uct-loading {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        gap: 6px !important;
        color: #6b7f99 !important;
        font-size: 0.82rem !important;
        padding: 8px 0 !important;
